# ============================================================
# Ministry Intelligence Platform (MIP) – Environment Variables
# Copy this file to .env and fill in all values before running setup.sh
# NEVER commit .env to Git.
# ============================================================

# ── PostgreSQL ───────────────────────────────────────────
POSTGRES_USER=ministry
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password_here
POSTGRES_DB=ministry_db

# ── NocoDB ───────────────────────────────────────────────
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
NOCODB_JWT_SECRET=CHANGE_ME_nocodb_jwt_secret_here

# NocoDB admin credentials (used by init_nocodb.py)
NOCODB_ADMIN_EMAIL=admin@ministry.org
NOCODB_ADMIN_PASSWORD=CHANGE_ME_nocodb_admin_password

# ── Apache Superset ──────────────────────────────────────
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
SUPERSET_SECRET_KEY=CHANGE_ME_superset_secret_key_here

# Superset admin account (created on first run)
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_FIRSTNAME=MIP
SUPERSET_ADMIN_LASTNAME=Admin
SUPERSET_ADMIN_EMAIL=admin@ministry.org
SUPERSET_ADMIN_PASSWORD=CHANGE_ME_superset_admin_password

# ── Google OAuth 2.0 (for Superset login) ───────────────
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=CHANGE_ME_google_oauth_secret

# ── MTN Mobile Money API ─────────────────────────────────
# Register at: https://momodeveloper.mtn.com
MTN_API_USER=CHANGE_ME_mtn_api_user_uuid
MTN_API_KEY=CHANGE_ME_mtn_api_key
MTN_SUBSCRIPTION_KEY=CHANGE_ME_mtn_subscription_key
# sandbox or production
MTN_ENVIRONMENT=sandbox
# Your MTN MoMo receiving account (for request-to-pay payee)
MTN_PAYEE_MSISDN=256700000000

# ── Airtel Money API ─────────────────────────────────────
# Register at: https://developers.airtel.africa
AIRTEL_CLIENT_ID=CHANGE_ME_airtel_client_id
AIRTEL_CLIENT_SECRET=CHANGE_ME_airtel_client_secret
# sandbox or production
AIRTEL_ENVIRONMENT=sandbox

# ── WhatsApp Cloud API ───────────────────────────────────
# Get from: https://developers.facebook.com/ → WhatsApp → API Setup
WHATSAPP_TOKEN=CHANGE_ME_permanent_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=CHANGE_ME_phone_number_id
# WhatsApp group IDs (get from Meta Business Manager or API)
WHATSAPP_GROUP_ID=CHANGE_ME_whatsapp_group_id
# Verification token for Meta webhook handshake (any random string)
WHATSAPP_VERIFY_TOKEN=CHANGE_ME_verify_token_string
# HMAC secret for payment webhook signature verification
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_hmac_secret_for_webhook

# ── Domain & SSL ─────────────────────────────────────────
DOMAIN=ministry.example.com
# For DuckDNS alternative: ministry.duckdns.org

# ── Oracle Object Storage (for backups) ──────────────────
OCI_BUCKET_NAME=mip-backups
OCI_NAMESPACE=CHANGE_ME_oci_namespace
# Path to backup encryption public key (age)
BACKUP_AGE_PUBLIC_KEY=CHANGE_ME_age_public_key

# ── Report Service Account ───────────────────────────────
# Email used by generate_report.py to authenticate with Superset
REPORT_SERVICE_EMAIL=admin@ministry.org
REPORT_SERVICE_PASSWORD=CHANGE_ME_superset_admin_password

# ── Semester Configuration ───────────────────────────────
CURRENT_SEMESTER=2026-S1
